new file mode 100755
index 0000000..2b41264
--- /dev/null
+++ b/mbcc-console-theme/uninstall.sh
@@ -0,0 +1,47 @@
+#!/bin/sh
+# Remove dsh-theme-mbcc-console from a DSH Desktop profile (macOS / Linux).
+# Usage:
+#   sh ./uninstall.sh
+#   sh ./uninstall.sh /path/to/profile
+set -eu
+
+PROFILE_DIR="${1:-$HOME/.dsh/profiles/desktop}"
+DEST="$PROFILE_DIR/node_modules/dsh-theme-mbcc-console"
+PATCH="$PROFILE_DIR/cordis.patch.yml"
+
+if [ -d "$DEST" ]; then
+  rm -rf "$DEST"
+  printf 'removed  -> %s\n' "$DEST"
+else
+  printf 'package  -> not installed\n'
+fi
+
+if [ -f "$PATCH" ]; then
+  tmp="$PATCH.tmp.$$"
+  awk '
+    { line[NR] = $0 }
+    END {
+      for (i = 1; i <= NR; i++) {
+        if (line[i] == "- insert:" &&
+            line[i + 1] == "    - id: mbcc-console" &&
+            line[i + 2] ~ /^      name: .dsh-theme-mbcc-console.$/) { i += 2; continue }
+        print line[i]
+      }
+    }
+  ' "$PATCH" > "$tmp"
+  mv "$tmp" "$PATCH"
+  # Leave an explicit empty array instead of a comments-only file (parses as null).
+  if ! grep -qEv '^[[:space:]]*(#|$)' "$PATCH"; then
+    [ -s "$PATCH" ] || : > "$PATCH"
+    if [ -s "$PATCH" ]; then
+      last=$(tail -c 1 "$PATCH" | od -An -t x1 | tr -d ' \n')
+      [ "$last" = "0a" ] || printf '\n' >> "$PATCH"
+    fi
+    printf '[]\n' >> "$PATCH"
+  fi
+  printf 'patch    -> entry removed (if present)\n'
+else
+  printf 'patch    -> %s not found\n' "$PATCH"
+fi
+
+printf '\nDone. Restart DSH Desktop to restore the default appearance.\n'
