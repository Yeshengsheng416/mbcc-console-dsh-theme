diff --git a/mbcc-console-theme/install.sh b/mbcc-console-theme/install.sh
new file mode 100755
index 0000000..3b80f73
--- /dev/null
+++ b/mbcc-console-theme/install.sh
@@ -0,0 +1,60 @@
+#!/bin/sh
+# Install dsh-theme-mbcc-console into a DSH Desktop profile (macOS / Linux).
+# Usage:
+#   sh ./install.sh
+#   sh ./install.sh /path/to/profile
+set -eu
+
+PROFILE_DIR="${1:-$HOME/.dsh/profiles/desktop}"
+SOURCE_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
+DEST="$PROFILE_DIR/node_modules/dsh-theme-mbcc-console"
+PATCH="$PROFILE_DIR/cordis.patch.yml"
+
+if [ ! -d "$PROFILE_DIR" ]; then
+  printf 'DSH profile not found: %s\n' "$PROFILE_DIR" >&2
+  printf 'Start DSH Desktop once, then re-run this script.\n' >&2
+  exit 1
+fi
+
+# 1) copy the package
+mkdir -p "$PROFILE_DIR/node_modules"
+rm -rf "$DEST"
+cp -R "$SOURCE_DIR" "$DEST"
+printf 'package  -> %s\n' "$DEST"
+
+# 2) add the patch row once
+if [ -f "$PATCH" ] && grep -q 'dsh-theme-mbcc-console' "$PATCH"; then
+  printf 'patch    -> entry already present\n'
+else
+  [ -f "$PATCH" ] || : > "$PATCH"
+  # A freshly initialised profile ships the placeholder `[]`; appending a list
+  # item after it is invalid YAML, so drop the placeholder first.
+  effective=$(grep -v '^[[:space:]]*#' "$PATCH" 2>/dev/null | tr -d '[:space:]' || true)
+  if [ "$effective" = "[]" ]; then
+    tmp="$PATCH.tmp.$$"
+    sed '/^[[:space:]]*\[\][[:space:]]*$/d' "$PATCH" > "$tmp"
+    mv "$tmp" "$PATCH"
+  fi
+  if [ -s "$PATCH" ]; then
+    last=$(tail -c 1 "$PATCH" | od -An -t x1 | tr -d ' \n')
+    [ "$last" = "0a" ] || printf '\n' >> "$PATCH"
+  fi
+  cat >> "$PATCH" <<'YAML'
+- insert:
+    - id: mbcc-console
+      name: 'dsh-theme-mbcc-console'
+YAML
+  printf 'patch    -> entry added\n'
+fi
+
+# 3) warn about other themes (two themes are not additive: later layer wins per token)
+theme_rows=$(grep -Ec 'theme-endfield|dsh-theme-' "$PATCH" 2>/dev/null || true)
+if [ "${theme_rows:-0}" -gt 1 ]; then
+  printf '\nWarning: another theme row exists in this profile.\n' >&2
+  printf 'Two themes override the same tokens; the later layer wins per token\n' >&2
+  printf 'and the other theme still injects its own CSS. Disable the other theme first:\n' >&2
+  printf "  - id: theme-endfield\n    disabled: true\n" >&2
+fi
+
+printf '\nDone. Restart DSH Desktop to apply.\n'
+printf 'Click the MBCC emblem at the top-left of the sidebar to open the theme panel.\n'
